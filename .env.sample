# --- Dienst-/Deploy-Variablen (docker-compose + Traefik + Woodpecker) ---
SERVICE=startseite
HOST=start.kirkanos.net
# Interner Port, auf dem die App lauscht (= Traefik-Ziel-Port).
PORT=3000

# --- App-Secrets ---
# bcrypt-Hash des Master-Passworts erzeugen mit:
#   docker compose run --rm web -hash "meinPasswort"
#   (lokal ohne Docker:  go run . -hash "meinPasswort")
APP_PASSWORD_HASH=
# Zufälliges Secret zum Signieren des Session-Cookies:  openssl rand -hex 32
SESSION_SECRET=
